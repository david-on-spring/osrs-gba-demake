wait 60
newgame
wait 40
# --- talk to the Cook in the castle kitchen
face COOK LEFT
talk
until8 @ui_wait 1 300
shot shots/q/cook_talk.png
dlg
dump @ui_wait 1
choose 0
dlg
choose 0
dlg
world
expectq COOK 1
# --- bucket and pot from the kitchen
face item:BUCKET UP
press A
wait 10
face item:POT UP
press A
wait 10
expectitem 9 BUCKET
expectitem 10 POT
# --- egg from the chicken coop north of the castle
tpz OVERWORLD 3231 3297 UP
press A
wait 10
expectitem 11 EGG
# --- wheat: pick from the field by the mill, mill it
tpz OVERWORLD 3164 3295 LEFT
press A
wait 10
expectitem 12 GRAIN
tpz OVERWORLD 3163 3308 UP
press A
wait 10
shot shots/q/cook_hopper.png
tpz OVERWORLD 3164 3303 LEFT
press A
wait 10
expectitem 10 POT_FLOUR
# --- milk the dairy cow
tpz OVERWORLD 3257 3272 LEFT
press A
wait 10
shot shots/q/cook_milk.png
expectitem 9 BUCKET_MILK
# --- open the journal mid-quest
press START
wait 20
press DOWN
press DOWN
press DOWN
press DOWN
press A
wait 10
press DOWN
press A
wait 15
shot shots/q/cook_journal.png
press B
press B
press START
wait 20
# --- hand everything in
face COOK LEFT
talk
until8 @ui_wait 1 300
shot shots/q/hh1.png
press A
until8 @ui_wait 1 300
shot shots/q/hh2.png
press A
until8 @ui_wait 1 300
shot shots/q/hh3.png
dlg
done
shot shots/q/cook_done.png
press A
wait 6
until8 @ui_wait 4 60
shot shots/q/cook_levelup.png
press A
world
expectq COOK 2
dumpq
