# Targeting and Ranged: L picks the cow, A opens the target menu, Attack shoots it from five tiles
# away without walking up to it; B lets the target go.
wait 60
newgame
world
clearinv
xp RANGED 400000
equip WEAPON SHORTBOW
equip AMMO BRONZE_ARROW 100
tpz OVERWORLD 3286 3306 RIGHT
npcpos COW OVERWORLD 3291 3306
wait 4
press L
wait 4
expecttarget COW
shot shots/t/ranged_target.png
press A
wait 4
expectstate TARGET
shot shots/t/ranged_menu.png
press A
wait 40
shot shots/t/ranged_shot.png
untildead COW
world
expectxp RANGED 400040
expectxp HITPOINTS 1
expecttarget NONE
expectat OVERWORLD 3286 3306
# --- B clears the target
npcpos COW:2 OVERWORLD 3289 3306
wait 4
press L
wait 4
expecttarget COW:2
press B
wait 4
expecttarget NONE
# --- arrows a shortbow can't fire, then an empty quiver
equip AMMO ADAMANT_ARROW 5
press L
wait 4
press A
wait 4
press A
wait 60
expectammo ADAMANT_ARROW 5
expectstate WORLD
# --- thrown knives: wielded as a stack, one thrown per attack, no bow or arrows needed
equip AMMO NONE
equip WEAPON RUNE_KNIFE 40
expectwqty 40
npcpos COW:2 OVERWORLD 3289 3306
wait 4
press L
wait 4
expecttarget COW:2
press A
wait 4
press A
untildead COW:2
world
expectequip WEAPON RUNE_KNIFE
expectlt16 @pl+0x294 28 knives_below_40
expectat OVERWORLD 3286 3306
